# B.E.A.M. scraper configuration — copy to .env and fill in real values.
# NEVER commit the real .env file.

# Reddit API credentials (https://www.reddit.com/prefs/apps -> create a "script" app)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Must identify your research use case per Reddit API rules, e.g.
# "windows:beam-research-scraper:v1.0 (by /u/your_username)"
REDDIT_USER_AGENT=windows:beam-research-scraper:v1.0 (by /u/your_username)

# PostgreSQL connection used by the scraper's own storage layer
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/beam_db

# Collection defaults (all optional)
SUBREDDITS=AskReddit,CasualConversation
POST_LIMIT=50
COMMENT_LIMIT=100
SCRAPE_SORT=new
TIME_FILTER=month
INCLUDE_COMMENTS=true
MIN_REQUEST_INTERVAL=1.1
LOG_LEVEL=INFO

# Privacy: salt used to pseudonymize author handles before storage.
# Raw handles are never persisted. Changing this re-anonymizes future
# collections; existing rows keep their stored pseudonyms.
AUTHOR_HASH_SALT=beam-scraper-author-v1
