# B.E.A.M. web environment configuration
#
# Copy to .env (git-ignored) only if you need to override the defaults.
# Vite only exposes variables prefixed with VITE_.

# Base URL of the FastAPI backend (no trailing slash).
# Default used by src/utils/env.ts when unset:
VITE_API_URL=http://localhost:8000

# The frontend calls `${VITE_API_URL}/api/v1/...`, e.g.
#   http://localhost:8000/api/v1/auth/login
